{
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://+:5001",
        "Certificate": {
          "Path": "",
          "Password": ""
        }
      }
    }
  },
  
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  
  "AllowedHosts": "*",

  "ReversedProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/auth/{**catch-all}",
          "Methods": [ "POST" ],
          "Transforms": [
            { "PathRemovePrefix": "/auth" }
          ]
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "authentication-service": {
            "Address": "http://authentication-service:80"
          }
        }
      }
    }
  }
}
